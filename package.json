{
  "name": "memotape",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "app:prova": "bun scripts/app-prova.ts",
    "build": "tsc && vite build",
    "check": "ultracite check",
    "dev": "vite",
    "fix": "ultracite fix",
    "format:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:backend": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "prepare": "husky",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "bunx ultracite fix"
    ]
  },
  "dependencies": {
    "@fontsource-variable/commissioner": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tauri-apps/api": "2.12.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "i18next": "26.4.2",
    "lucide-react": "1.50.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "react-router": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/bun": "1.4.2",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "ultracite": "7.12.2",
    "vite": "8.3.2"
  }
