{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    // Solo negazioni: il core di ultracite 7.12 apre già con "**", e ripeterlo è un errore
    // (noBiomeFirstException). Senza un "**" da qualche parte Biome non controlla nulla.
    // I componenti shadcn e i bindings generati non si toccano a mano.
    // Prove temporanee, output Rust e worktree degli agenti (.claude) non fanno parte dei sorgenti dell'app.
    "includes": [
      "!**/components/ui",
      "!**/bindings.ts",
      "!.scratch",
      "!**/target",
      "!.claude"
    ]
  }
}
