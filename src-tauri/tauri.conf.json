{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memotape",
  "identifier": "it.memotape.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "EDITORE DA DEFINIRE",
    "fileAssociations": [
      {
        "ext": ["tape"],
        "name": "Memotape.Tape",
        "description": "Tape (Memotape)",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "Memotape",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5OTYwRDAyNDk0MUIyRjkKUldUNXNrRkpBZzJXeVdhQVQ2K0FPRzBuZVVMaDRKalNza29aUzduQmpLL2RKYjh5Um5vSG1rbTAK",
      "endpoints": [
        "https://github.com/inerba/memotape/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
