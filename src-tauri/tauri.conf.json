{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sbobino",
  "identifier": "sbobino",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Sbobino",
        "width": 1000,
        "height": 700,
        "dragDropEnabled": false
      }
    ]
  }
}
